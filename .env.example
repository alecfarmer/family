# Supabase (https://supabase.com → project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin (https in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AES-256-GCM key for credential password encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Web Push (VAPID) — generate with `node scripts/generate-vapid.mjs`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=you@example.com

# Vercel AI Gateway — auto-provisioned in production. For local dev: `vercel env pull .env.local`
AI_GATEWAY_API_KEY=

# Admin display name used in user-facing copy ("Ask Alec")
ADMIN_DISPLAY_NAME=Alec
